{
  "name": "@artenx/dshb",
  "version": "0.0.4",
  "description": "DSH-HoneyBee \u805a\u5408\u5305\u2014\u2014\u4e00\u6761\u547d\u4ee4\u5b89\u88c5\u5168\u90e8 DSHB \u63d2\u4ef6",
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible"
      },
      "nodeVersions": ">=22.13"
    }
  },
  "dependencies": {
    "dshb-auth": "workspace:*",
    "dshb-core": "workspace:*",
    "dshb-router": "workspace:*",
    "dshb-exec-ssh": "workspace:*",
    "dshb-exec-docker": "workspace:*",
    "dshb-ui": "workspace:*"
  }
