{
  "name": "dshb-router",
  "version": "0.0.5",
  "description": "DSHB \u6267\u884c\u4e16\u754c\u8def\u7531\u5668\uff08ctx.fs / ctx.subprocess / ctx.shell \u6309\u955c\u50cf\u8def\u5f84\u5206\u6d41\uff09",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./fs": "./lib/decorate-fs.js",
    "./subprocess": "./lib/decorate-subprocess.js",
    "./shell": "./lib/decorate-shell.js",
    "./resolve": "./lib/resolve.js",
    "./types": "./lib/types.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible"
      },
      "nodeVersions": ">=22.13"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "types": "lib/index.d.ts"
}
