{
  "name": "dshb-core",
  "version": "0.0.1",
  "description": "DSHB 节点注册表（ctx.nodeRegistry）与凭据托管",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./node-registry": "./lib/node-registry.js",
    "./ssh-config": "./lib/ssh-config.js",
    "./known-hosts": "./lib/known-hosts.js",
    "./workspace-bindings": "./lib/workspace-bindings.js",
    "./audit": "./lib/audit.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "dshb-router": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
