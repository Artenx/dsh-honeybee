{
  "name": "dshb-core",
  "version": "0.0.4",
  "description": "DSHB \u8282\u70b9\u6ce8\u518c\u8868\uff08ctx.nodeRegistry\uff09\u4e0e\u51ed\u636e\u6258\u7ba1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./node-registry": "./lib/node-registry.js",
    "./ssh-config": "./lib/ssh-config.js",
    "./known-hosts": "./lib/known-hosts.js",
    "./workspace-bindings": "./lib/workspace-bindings.js",
    "./audit": "./lib/audit.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible"
      },
      "nodeVersions": ">=22.13"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "dshb-router": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "types": "lib/index.d.ts"
}
