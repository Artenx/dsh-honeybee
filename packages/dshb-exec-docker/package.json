{
  "name": "dshb-exec-docker",
  "version": "0.0.5",
  "description": "DSHB \u672c\u5730 Docker \u5bb9\u5668\u6267\u884c\u4e16\u754c\uff08Docker Engine API + exec/SFTP/PTY\uff09",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./docker-client": "./lib/docker-client.js",
    "./world": "./lib/world.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible"
      },
      "nodeVersions": ">=22.13"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "dshb-router": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2"
  },
  "types": "lib/index.d.ts"
}
