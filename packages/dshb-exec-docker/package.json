{
  "name": "dshb-exec-docker",
  "version": "0.0.1",
  "description": "DSHB 本地 Docker 容器执行世界（Docker Engine API + exec/SFTP/PTY）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./docker-client": "./lib/docker-client.js",
    "./world": "./lib/world.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "dshb-router": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2"
  }
}
