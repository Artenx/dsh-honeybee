{
  "name": "dshb-exec-ssh",
  "version": "0.0.1",
  "description": "DSHB 远程 SSH 执行世界（exec 行协议 / SFTP / PTY over ssh2）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./connection": "./lib/connection.js",
    "./connection-pool": "./lib/connection-pool.js",
    "./env-scrub": "./lib/env-scrub.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/ssh2": "^1.15.6"
  }
}
