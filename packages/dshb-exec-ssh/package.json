{
  "name": "dshb-exec-ssh",
  "version": "0.0.5",
  "description": "DSHB \u8fdc\u7a0b SSH \u6267\u884c\u4e16\u754c\uff08exec \u884c\u534f\u8bae / SFTP / PTY over ssh2\uff09",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./connection": "./lib/connection.js",
    "./connection-pool": "./lib/connection-pool.js",
    "./env-scrub": "./lib/env-scrub.js",
    "./executor": "./lib/executor.js",
    "./fs-provider": "./lib/fs-provider.js",
    "./process-provider": "./lib/process-provider.js",
    "./world": "./lib/world.js",
    "./runner": "./lib/runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible"
      },
      "nodeVersions": ">=22.13"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dshb-router": "workspace:*",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.5-rc.1",
    "@types/ssh2": "^1.15.6"
  },
  "types": "lib/index.d.ts"
}
